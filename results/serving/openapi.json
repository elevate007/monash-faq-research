{
  "openapi": "3.1.0",
  "info": {
    "title": "Monash FAQ Research API",
    "description": "Source-grounded FAQ serving with explicit abstention and operational monitoring. Snapshot support is not proof of current policy or correct relevance.",
    "version": "0.2.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Health",
        "operationId": "health_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Ready",
        "operationId": "ready_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/answer": {
      "post": {
        "summary": "Answer",
        "operationId": "answer_v1_answer_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnswerRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnswerResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/monitoring": {
      "get": {
        "summary": "Monitoring",
        "operationId": "monitoring_v1_monitoring_get",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/audiences": {
      "get": {
        "summary": "Audiences",
        "operationId": "audiences_v1_audiences_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnswerRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 3,
            "title": "Question"
          },
          "audience": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ],
            "title": "Audience"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AnswerRequest"
      },
      "AnswerResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "abstained": {
            "type": "boolean",
            "title": "Abstained"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "mode": {
            "type": "string",
            "enum": [
              "grounded",
              "generative",
              "extractive"
            ],
            "title": "Mode"
          },
          "model": {
            "$ref": "#/components/schemas/ModelMetadata"
          },
          "snapshot_date": {
            "type": "string",
            "title": "Snapshot Date"
          },
          "support_check": {
            "type": "string",
            "enum": [
              "none",
              "exact_snapshot_text",
              "surface_checks_only"
            ],
            "title": "Support Check"
          },
          "retrieval": {
            "$ref": "#/components/schemas/RetrievalSignals"
          },
          "latency_ms": {
            "type": "number",
            "minimum": 0.0,
            "title": "Latency Ms"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "answer",
          "abstained",
          "reason",
          "citations",
          "mode",
          "model",
          "snapshot_date",
          "support_check",
          "retrieval",
          "latency_ms"
        ],
        "title": "AnswerResponse"
      },
      "Citation": {
        "properties": {
          "record_id": {
            "type": "string",
            "title": "Record Id"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "audience": {
            "type": "string",
            "title": "Audience"
          },
          "candidate_only": {
            "type": "boolean",
            "title": "Candidate Only"
          }
        },
        "type": "object",
        "required": [
          "record_id",
          "url",
          "audience",
          "candidate_only"
        ],
        "title": "Citation"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ModelMetadata": {
        "properties": {
          "backend": {
            "type": "string",
            "enum": [
              "qwen",
              "extractive"
            ],
            "title": "Backend"
          },
          "model_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Id"
          },
          "model_revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Revision"
          },
          "adapter_loaded": {
            "type": "boolean",
            "title": "Adapter Loaded"
          },
          "device": {
            "type": "string",
            "title": "Device"
          },
          "quantization": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quantization"
          }
        },
        "type": "object",
        "required": [
          "backend",
          "model_id",
          "model_revision",
          "adapter_loaded",
          "device",
          "quantization"
        ],
        "title": "ModelMetadata"
      },
      "RetrievalSignals": {
        "properties": {
          "coverage": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Coverage"
          },
          "threshold": {
            "type": "number",
            "maximum": 1.01,
            "minimum": 0.0,
            "title": "Threshold"
          },
          "record_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Record Ids"
          },
          "scores": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Scores"
          }
        },
        "type": "object",
        "required": [
          "coverage",
          "threshold",
          "record_ids",
          "scores"
        ],
        "title": "RetrievalSignals"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}